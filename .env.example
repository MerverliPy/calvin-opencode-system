# Calvin opencode System environment template
# Copy to .env only if needed.
# Never commit .env.

# GitHub MCP placeholder.
# Used only if GitHub MCP is explicitly enabled.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Local model endpoints.
OLLAMA_BASE_URL=http://localhost:11434/v1
